{
  "name": "github-explorer-ria",
  "version": "1.0.0",
  "description": "RIA - Explorador de GitHub con React y Bootstrap",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "lint": "eslint src",
    "lighthouse": "lighthouse http://localhost:4173 --output html --output-path informe-lighthouse.html --locale es --view",
    "lighthouse:docker": "lighthouse http://localhost:3000 --output html --output-path informe-lighthouse.html --locale es --view"
  },
  "dependencies": {
    "axios": "1.16.0",
    "bootstrap": "5.3.8",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-router-dom": "7.16.0"
  },
  "devDependencies": {
    "@playwright/test": "1.60.0",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.0",
    "@vitejs/plugin-react": "4.7.0",
    "eslint": "10.4.1",
    "jsdom": "29.1.1",
    "lighthouse": "12.8.2",
    "vite": "6.4.2",
    "vitest": "4.1.7"
  }
}
